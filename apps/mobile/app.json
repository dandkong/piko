{
  "expo": {
    "name": "Piko",
    "slug": "piko",
    "scheme": "piko",
    "version": "0.1.0",
    "icon": "./assets/capybara.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.piko.assistant"
    },
    "android": {
      "package": "com.piko.assistant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/capybara.png",
        "backgroundColor": "#f7f5f0"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Piko"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}

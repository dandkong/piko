{
  "expo": {
    "name": "Piko",
    "slug": "piko",
    "scheme": "piko",
    "version": "0.1.0",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/capybara.png",
      "name": "Piko",
      "shortName": "Piko",
      "lang": "zh-CN",
      "description": "Piko 个人助理",
      "startUrl": "/",
      "scope": "/",
      "display": "standalone",
      "orientation": "portrait",
      "themeColor": "#FCFCFC",
      "backgroundColor": "#FCFCFC"
    },
    "icon": "./assets/capybara.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.piko.assistant"
    },
    "android": {
      "package": "com.piko.assistant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/capybara.png",
        "backgroundColor": "#FCFCFC"
      }
    },
    "plugins": [
      "expo-status-bar",
      "./plugins/with-android-adjust-nothing"
    ]
  }
}

{
  "name": "piko-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo start --android --port 8081",
    "build:web": "expo export --platform web --output-dir dist/web",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "build:android": "expo export --platform android --output-dir dist/android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-audio": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "1.67.0",
    "markdown-it": "15.0.3",
    "markdown-it-cjk-friendly": "3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-markdown-renderer": "4.1.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "remend": "1.4.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "node-forge": "1.4.3",
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}

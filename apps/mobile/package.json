{
  "name": "piko-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo start --android --port 8081",
    "build:web": "expo export --platform web --output-dir dist/web",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "build:android": "expo export --platform android --output-dir dist/android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-crypto": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "1.49.0",
    "markdown-it": "14.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-markdown-renderer": "4.1.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "remend": "1.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/react": "~19.2.4",
    "typescript": "7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
